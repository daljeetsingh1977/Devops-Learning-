{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ComplaintDatabase": "Data Source=App_Data/complaints.db"
  },
  "PhotoStorage": {
    "RootPath": "App_Data/photos",
    "MaxPhotosPerComplaint": 5,
    "MaxFileSizeInBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/heic" ]
  },
  "Email": {
    "FromAddress": "no-reply@citizen-services.example.gov",
    "FromDisplayName": "Citizen Services",
    "OutboxPath": "App_Data/outbox"
